---
import { BASE } from "../lib/site";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={`${BASE}/`}>Oneday</a>
      <a class="repo" href="https://github.com/Blind-Guess-Senior/Oneday" target="_blank" rel="noopener">
        GitHub
      </a>
    </header>
    <main class="main"><slot /></main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #14161a;
    --panel: #1b1e24;
    --border: #2c313a;
    --text: #e6e8ec;
    --muted: #99a1ae;
    --accent: #4f9cf9;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 15px/1.8 -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", "Microsoft YaHei",
      sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 940px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .repo {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .main {
    max-width: 940px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 5rem;
  }

  .page-title {
    font-size: 1.4rem;
    margin: 0 0 0.25rem;
  }

  .count {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 1.5rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
  }

  .card {
    display: block;
    padding: 0.85rem 0.95rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card-title {
    font-weight: 600;
    margin: 0.4rem 0 0.35rem;
    word-break: break-word;
  }

  .card-aka {
    color: var(--muted);
    font-size: 0.8rem;
    margin-bottom: 0.35rem;
  }

  .card-meta {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .badge {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .score {
    color: var(--text);
  }

  .card-tags {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .card-tag {
    padding: 0.05rem 0.4rem;
    background: #22262e;
    border-radius: 4px;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .article-wrap {
    max-width: 720px;
  }

  .back {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .article-title {
    font-size: 1.7rem;
    margin: 1rem 0 0.4rem;
    word-break: break-word;
  }

  .article-aka {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.6rem 0.85rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .meta-bar strong {
    color: var(--text);
  }

  .sub-scores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    margin-bottom: 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--panel);
    border-radius: 0 8px 8px 0;
    font-size: 0.85rem;
  }

  .md-body h1,
  .md-body h2,
  .md-body h3 {
    line-height: 1.4;
    margin: 1.8rem 0 0.6rem;
  }

  .md-body h2 {
    font-size: 1.15rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border);
  }

  .md-body img {
    max-width: 100%;
    border-radius: 8px;
  }

  .md-body a {
    color: var(--accent);
  }

  .md-body hr {
    border: none;
    border-top: 1px dashed var(--border);
    margin: 2rem 0;
  }

  .md-body code {
    background: #22262e;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  mark.hl {
    background: #ffd54a33;
    color: var(--text);
    padding: 0 0.15rem;
    border-radius: 3px;
  }

  .standards-list {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>
