---
import "../styles/global.css";
import { reviewerStyles } from "../lib/reviewer-styles";
import { BASE } from "../lib/site";

interface Props {
  title: string;
}

const { title } = Astro.props;
const reviewerCss = await reviewerStyles();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- 各作者自己的评分档位配色，已按 data-reviewer 作用域隔离 -->
    <style is:global set:html={reviewerCss}></style>
  </head>
  <body>
    <header>
      <a class="logo" href={`${BASE}/`}>Oneday</a>
      <div class="header-right">
        <a href="https://github.com/Blind-Guess-Senior/Oneday" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.7 18 5 18 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"
            ></path>
          </svg>
          GitHub
        </a>
      </div>
    </header>
    <slot />
  </body>
</html>
