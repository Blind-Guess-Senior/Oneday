---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { entryUrl } from "../lib/site";

interface Row {
  id: string;
  title: string;
  reviewer: string;
  category: string[];
  scoreRaw: string;
  tags: string[];
  aka: string[];
  modified: string;
  scoreOnly: boolean;
}

function toRow(entry: { id: string; data: unknown }): Row {
  const data = entry.data as Record<string, unknown>;
  const list = (key: string): string[] =>
    Array.isArray(data[key]) ? (data[key] as string[]).map(String) : [];
  return {
    id: entry.id,
    title: String(data["title"] ?? entry.id),
    reviewer: String(data["reviewer"] ?? ""),
    category: list("category"),
    scoreRaw: String(data["score_raw"] ?? ""),
    tags: list("tags"),
    aka: list("aka"),
    modified: String(data["modified"] ?? ""),
    scoreOnly: data["score_only"] === true,
  };
}

const reviews = await getCollection("reviews");
const standards = await getCollection("standards");

const rows = reviews
  .map(toRow)
  .sort((a, b) => b.modified.localeCompare(a.modified));

const standardRows = standards.map((entry) => {
  const data = entry.data as Record<string, unknown>;
  return {
    id: entry.id,
    title: String(data["title"] ?? entry.id),
    reviewer: String(data["reviewer"] ?? ""),
    category: String(data["category"] ?? ""),
  };
});
---

<Layout title="Oneday">
  <h1 class="page-title">Oneday</h1>
  <p class="count">
    共 {rows.length} 篇评测（完整 {rows.filter((r) => !r.scoreOnly).length} 篇、仅评分 {rows.filter(
      (r) => r.scoreOnly,
    ).length} 篇）、{standardRows.length} 份评分标准
  </p>

  <div class="cards-grid">
    {
      rows.map((row) => (
        <a class="card" href={entryUrl(row.id)}>
          <span class="badge">{row.category[0] ?? "其他"}</span>
          <div class="card-title">{row.title}</div>
          {row.aka[0] && <div class="card-aka">{row.aka[0]}</div>}
          <div class="card-meta">
            <span>{row.reviewer}</span>
            <span>·</span>
            <span class="score">{row.scoreRaw || "未评分"}</span>
          </div>
          {row.tags.length > 0 && (
            <div class="card-tags">
              {row.tags.slice(0, 4).map((tag) => (
                <span class="card-tag">{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))
    }
  </div>

  <div class="standards-list">
    <h2 class="page-title">评分标准</h2>
    <div class="cards-grid">
      {
        standardRows.map((row) => (
          <a class="card" href={entryUrl(`standard/${row.id}`)}>
            <span class="badge">{row.category}</span>
            <div class="card-title">{row.title}</div>
            <div class="card-meta">
              <span>{row.reviewer}</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
